with Files("**"):
    BUG_COMPONENT = ("Firefox", "Cast")

XPIDL_SOURCES += [
    "nsICastDevice.idl",
    "nsICastVideoEncoder.idl",
]

XPIDL_MODULE = "cast"

XPCOM_MANIFESTS += [
    "components.conf",
]

EXTRA_JS_MODULES.cast = [
    "actors/CastTabChild.sys.mjs",
    "actors/CastTabParent.sys.mjs",
    "CastService.sys.mjs",
    "modules/CastConstants.mjs",
    "modules/CastDevice.sys.mjs",
    "modules/CastError.mjs",
    "modules/CastMediaHandler.sys.mjs",
    "modules/CastMediaSession.sys.mjs",
    "modules/CastSession.sys.mjs",
    "modules/SimpleHTTPServer.sys.mjs",
]

UNIFIED_SOURCES += [
    "src/webm_writer_bridge.cpp",
]

LOCAL_INCLUDES += [
    "/dom/media/encoder",
    "/dom/media/webm",
]

FINAL_LIBRARY = "browsercomps"
