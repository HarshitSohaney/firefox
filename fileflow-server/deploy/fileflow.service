[Unit]
Description=FileFlow Server
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/fileflow/server
ExecStart=/opt/fileflow/server/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
